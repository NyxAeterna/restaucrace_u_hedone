<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Přidat jídlo</title>
    <link rel="stylesheet" href="/css/adminMenu.css">  
    <link rel="stylesheet" href="/css/addMeal.css">
</head>
<body>
    <%-include('./partials/header2')%>
    <h2>Přidat nové jídlo</h2>

    <form action="/admin/menu/add" method="POST">
<p>
     <div class="name"><label for="name">Název jídla:</label>
        <input type="text" id="name" name="name" required></div>   
<br>
        <label for="description">Popis:</label>
        <textarea id="description" name="description"></textarea>
<br>
        <label for="price">Cena (Kč):</label>
        <input type="number" id="price" name="price"
               min="0.01" step="0.01" required>
<br>
        <label for="category_id">Kategorie:</label>
        <select id="category_id" name="category_id" required>
            <% categories.forEach(category => { %>
                <option value="<%= category.id %>">
                    <%= category.name %>
                </option>
            <% }) %>
      </p>  </select>
<br>
<br>
        <button type="submit">Uložit jídlo</button>
    </form>
<br>
   <div class="a"><a href="/admin/menu">Zpět na seznam jídel</a></div> 
</body>
</html>