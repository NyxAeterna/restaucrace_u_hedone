<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upravení stávajících jídel</title>
    <link rel="stylesheet" href="/css/editMeal.css">  
</head>
<body>
    <%-include('./partials/header2')%>
    <h2>Upravit jídlo</h2>

<form action="/admin/menu/<%= item.id %>/edit" method="POST">

    <label for="name">Název jídla:</label>
    <input
        type="text"
        id="name"
        name="name"
        value="<%= item.name %>"
        required
    >
<br>
    <label for="description">Popis:</label>
    <textarea
        id="description"
        name="description"
    ><%= item.description || '' %></textarea>
<br>
    <label for="price">Cena:</label>
    <input
        type="number"
        id="price"
        name="price"
        step="0.01"
        min="0"
        value="<%= item.price %>"
        required
    >

    <label for="category_id">Kategorie:</label>
    <select id="category_id" name="category_id" required>
        <% categories.forEach(category => { %>
            <option
                value="<%= category.id %>"
                <%= category.id === item.category_id ? 'selected' : '' %>
            >
                <%= category.name %>
            </option>
        <% }) %>
    </select>
<br>
    <button type="submit">Uložit změny</button>

</form>
<br>
<div class="a"><a href="/admin/menu">Zpět na seznam jídel</a></div>

</body>
</html>